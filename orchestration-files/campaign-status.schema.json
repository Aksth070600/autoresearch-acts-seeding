{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Aksth070600/autoresearch-acts-seeding/main/orchestration-files/campaign-status.schema.json",
  "title": "ACTS Seeding live campaign status",
  "description": "Backward-compatible snapshots for fixed and continuous controlled ACTS Seeding campaigns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "protocol_id",
    "generated_at",
    "stale_after_seconds",
    "repository",
    "campaign",
    "current_attempt",
    "progress",
    "promising_results",
    "attempts",
    "blockers",
    "failures",
    "links"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "protocol_id": {"enum": ["acts-seeding-v2", "acts-seeding-v3"]},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "stale_after_seconds": {"type": "integer", "minimum": 60},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "snapshot_path"],
      "properties": {
        "url": {"const": "https://github.com/Aksth070600/autoresearch-acts-seeding"},
        "snapshot_path": {
          "enum": [
            "orchestration-files/campaign-status.json",
            "campaign-status.json"
          ]
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "branch", "phase", "started_at", "targets"],
      "properties": {
        "name": {"$ref": "#/$defs/label"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "phase": {"$ref": "#/$defs/label"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "targets": {"$ref": "#/$defs/campaignTargets"},
        "mode": {"enum": ["fixed", "continuous"]},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
        "control_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "genesis_commit": {"$ref": "#/$defs/fullCommit"}
      }
    },
    "current_attempt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/legacyCurrentAttempt"},
        {"$ref": "#/$defs/currentCandidate"}
      ]
    },
    "progress": {
      "oneOf": [
        {"$ref": "#/$defs/legacyProgress"},
        {"$ref": "#/$defs/candidateProgress"}
      ]
    },
    "promising_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_genesis", "best_seeding", "pareto_front"],
      "oneOf": [
        {"required": ["best_ambiguity_efficiency"]},
        {"required": ["best_seeding_efficiency"]}
      ],
      "properties": {
        "latest_genesis": {"$ref": "#/$defs/nullableResult"},
        "best_seeding": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/bestSeedingResult"}
          ]
        },
        "best_ambiguity_efficiency": {"$ref": "#/$defs/nullableResult"},
        "best_seeding_efficiency": {"$ref": "#/$defs/nullableResult"},
        "pareto_front": {
          "type": "array",
          "items": {"$ref": "#/$defs/result"}
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/legacyAttempt"},
          {"$ref": "#/$defs/candidateAttempt"}
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {"message": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "message", "record_url"],
        "properties": {
          "candidate": {"$ref": "#/$defs/candidate"},
          "message": {"type": "string", "minLength": 1, "maxLength": 500},
          "record_url": {"type": "string", "format": "uri"}
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_branch", "pull_request", "active_commit"],
      "properties": {
        "campaign_branch": {"type": "string", "format": "uri"},
        "pull_request": {"$ref": "#/$defs/nullableUri"},
        "active_commit": {"$ref": "#/$defs/nullableUri"}
      }
    },
    "control": {"$ref": "#/$defs/campaignControl"},
    "scheduler": {"$ref": "#/$defs/schedulerSnapshot"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "campaign": {
            "required": ["mode"],
            "properties": {"mode": {"const": "continuous"}}
          }
        }
      },
      "then": {
        "required": ["control", "scheduler"],
        "properties": {
          "schema_version": {"const": "1.1.0"},
          "campaign": {
            "required": ["mode", "campaign_id", "control_id", "genesis_commit"],
            "properties": {"targets": {"$ref": "#/$defs/continuousTargets"}}
          },
          "current_attempt": {
            "oneOf": [
              {"type": "null"},
              {"allOf": [{"$ref": "#/$defs/currentCandidate"}, {"required": ["scheduling"]}]}
            ]
          },
          "progress": {"required": ["composition"]}
        }
      },
      "else": {"properties": {"schema_version": {"const": "1.0.0"}}}
    }
  ],
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "label": {"type": "string", "minLength": 1, "maxLength": 120},
    "candidate": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 80},
    "fullCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fileLineRange": {
      "type": "string",
      "pattern": "^optimization-files/[^#]+#L[1-9][0-9]*-L[1-9][0-9]*$",
      "maxLength": 300
    },
    "number": {"type": "number"},
    "nonnegativeNumber": {"type": "number", "minimum": 0},
    "nonnegativeInteger": {"type": "integer", "minimum": 0},
    "nullableNumber": {"type": ["number", "null"]},
    "nullableNonnegativeNumber": {"type": ["number", "null"], "minimum": 0},
    "nullableUri": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "uri"}
      ]
    },
    "continuousTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major_percentage", "minor_percentage", "combination_percentage"],
      "properties": {
        "major_percentage": {"const": 50},
        "minor_percentage": {"const": 25},
        "combination_percentage": {"const": 25}
      }
    },
    "campaignTargets": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed_attempts", "structural_attempts", "micro_optimization_cap"],
          "properties": {
            "completed_attempts": {"type": "integer", "minimum": 1},
            "structural_attempts": {"type": "integer", "minimum": 0},
            "micro_optimization_cap": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed_candidates", "major_candidates", "minor_candidates", "combination_candidates"],
          "properties": {
            "completed_candidates": {"type": "integer", "minimum": 1},
            "major_candidates": {"type": "integer", "minimum": 0},
            "minor_candidates": {"type": "integer", "minimum": 0},
            "combination_candidates": {"type": "integer", "minimum": 0}
          }
        },
        {"$ref": "#/$defs/continuousTargets"}
      ]
    },
    "legacyCurrentAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "mechanism_family", "classification", "controlled_stage", "state", "started_at"],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "mechanism_family": {"$ref": "#/$defs/label"},
        "classification": {"enum": ["baseline", "structural", "micro"]},
        "controlled_stage": {"$ref": "#/$defs/label"},
        "state": {"enum": ["queued", "running", "recording", "blocked"]},
        "started_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]}
      }
    },
    "currentCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "mechanism_key", "mechanism_family", "classification", "controlled_stage", "state", "started_at"],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "mechanism_key": {"$ref": "#/$defs/label"},
        "mechanism_family": {"$ref": "#/$defs/label"},
        "classification": {"enum": ["baseline", "major", "minor", "combination"]},
        "controlled_stage": {"$ref": "#/$defs/label"},
        "state": {"enum": ["queued", "running", "recording", "blocked"]},
        "started_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "scheduling": {"enum": ["ordinary", "finalization"]}
      }
    },
    "legacyProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_attempts",
        "structural_attempts",
        "micro_optimizations",
        "elapsed_seconds",
        "median_completed_attempt_duration_seconds",
        "estimated_remaining_seconds",
        "expected_finish_at",
        "eta_sample_count",
        "eta_basis"
      ],
      "properties": {
        "completed_attempts": {"$ref": "#/$defs/nonnegativeInteger"},
        "structural_attempts": {"$ref": "#/$defs/nonnegativeInteger"},
        "micro_optimizations": {"$ref": "#/$defs/nonnegativeInteger"},
        "elapsed_seconds": {"$ref": "#/$defs/nonnegativeNumber"},
        "median_completed_attempt_duration_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "estimated_remaining_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "expected_finish_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "eta_sample_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "eta_basis": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "candidateProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_candidates",
        "major_candidates",
        "minor_candidates",
        "combination_candidates",
        "elapsed_seconds",
        "median_completed_attempt_duration_seconds",
        "estimated_remaining_seconds",
        "expected_finish_at",
        "eta_sample_count",
        "eta_basis"
      ],
      "properties": {
        "completed_candidates": {"$ref": "#/$defs/nonnegativeInteger"},
        "major_candidates": {"$ref": "#/$defs/nonnegativeInteger"},
        "minor_candidates": {"$ref": "#/$defs/nonnegativeInteger"},
        "combination_candidates": {"$ref": "#/$defs/nonnegativeInteger"},
        "elapsed_seconds": {"$ref": "#/$defs/nonnegativeNumber"},
        "median_completed_attempt_duration_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "estimated_remaining_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "expected_finish_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "eta_sample_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "eta_basis": {"type": "string", "minLength": 1, "maxLength": 300},
        "composition": {"$ref": "#/$defs/candidateComposition"}
      }
    },
    "candidateComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "combination"],
      "properties": {
        "major": {"$ref": "#/$defs/compositionCategory"},
        "minor": {"$ref": "#/$defs/compositionCategory"},
        "combination": {"$ref": "#/$defs/compositionCategory"}
      }
    },
    "compositionCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "target_percentage", "completed_percentage", "deficit_candidates"],
      "properties": {
        "completed": {"$ref": "#/$defs/nonnegativeInteger"},
        "target_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "completed_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "deficit_candidates": {"type": "number"}
      }
    },
    "stopRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "campaign_branch", "control_id", "issue_number", "issue_url", "requested_at", "requested_by", "workflow_run_id", "workflow_run_attempt", "workflow_run_url"],
      "properties": {
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
        "campaign_branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "control_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "issue_url": {"type": "string", "format": "uri"},
        "requested_at": {"$ref": "#/$defs/timestamp"},
        "requested_by": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "workflow_run_attempt": {"type": "integer", "minimum": 1},
        "workflow_run_url": {"type": "string", "format": "uri"}
      }
    },
    "campaignControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "request", "observed_at", "consumed_at", "completed_at"],
      "properties": {
        "state": {"enum": ["open", "requested", "consumed", "completed"]},
        "request": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stopRequest"}]},
        "observed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "consumed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "completed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]}
      }
    },
    "finalTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_candidates", "major_candidates", "minor_candidates", "combination_candidates"],
      "properties": {
        "completed_candidates": {"type": "integer", "minimum": 4},
        "major_candidates": {"type": "integer", "minimum": 2},
        "minor_candidates": {"type": "integer", "minimum": 1},
        "combination_candidates": {"type": "integer", "minimum": 1}
      }
    },
    "categoryDeficits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "combination"],
      "properties": {
        "major": {"$ref": "#/$defs/nonnegativeInteger"},
        "minor": {"$ref": "#/$defs/nonnegativeInteger"},
        "combination": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "schedulerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "category", "reason"],
      "properties": {
        "action": {"enum": ["schedule", "cancel-queued", "finish-active", "consume-stop", "schedule-finalization", "blocked", "finalize", "complete"]},
        "category": {"oneOf": [{"type": "null"}, {"enum": ["baseline", "major", "minor", "combination"]}]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "final_targets": {"$ref": "#/$defs/finalTargets"},
        "deficits": {"$ref": "#/$defs/categoryDeficits"}
      }
    },
    "schedulerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "strategy", "combination_eligible", "final_targets", "blocker", "decision"],
      "properties": {
        "state": {"enum": ["running", "finishing", "completed", "blocked"]},
        "strategy": {"const": "deterministic-deficit-2:1:1-v1"},
        "combination_eligible": {"type": "boolean"},
        "final_targets": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/finalTargets"}]},
        "blocker": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 500}]},
        "decision": {"$ref": "#/$defs/schedulerDecision"}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "record"],
      "properties": {
        "commit": {"$ref": "#/$defs/nullableUri"},
        "record": {"type": "string", "format": "uri"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "timed_seeding_time_per_event_ms", "started_at", "links"],
      "oneOf": [
        {"required": ["timed_ambiguity_particle_efficiency"]},
        {"required": ["timed_seeding_particle_efficiency"]}
      ],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "timed_seeding_time_per_event_ms": {"$ref": "#/$defs/nonnegativeNumber"},
        "timed_ambiguity_particle_efficiency": {"type": "number", "minimum": 0, "maximum": 1},
        "timed_seeding_particle_efficiency": {"type": "number", "minimum": 0, "maximum": 1},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "links": {"$ref": "#/$defs/links"}
      }
    },
    "nullableResult": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]},
    "bestSeedingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "timed_seeding_time_per_event_ms", "started_at", "links", "delta_vs_genesis_ms", "percentage_vs_genesis"],
      "oneOf": [
        {"required": ["timed_ambiguity_particle_efficiency"]},
        {"required": ["timed_seeding_particle_efficiency"]}
      ],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "timed_seeding_time_per_event_ms": {"$ref": "#/$defs/nonnegativeNumber"},
        "timed_ambiguity_particle_efficiency": {"type": "number", "minimum": 0, "maximum": 1},
        "timed_seeding_particle_efficiency": {"type": "number", "minimum": 0, "maximum": 1},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "links": {"$ref": "#/$defs/links"},
        "delta_vs_genesis_ms": {"$ref": "#/$defs/nullableNumber"},
        "percentage_vs_genesis": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "legacyAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "mechanism_family", "classification", "state", "outcome", "started_at", "finished_at", "duration_seconds", "timed_seeding_time_per_event_ms", "implementation_commit", "links", "record"],
      "oneOf": [
        {"required": ["timed_ambiguity_particle_efficiency"]},
        {"required": ["timed_seeding_particle_efficiency"]}
      ],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "mechanism_family": {"$ref": "#/$defs/label"},
        "classification": {"enum": ["baseline", "structural", "micro"]},
        "state": {"enum": ["completed", "failed"]},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 500},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "duration_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "timed_seeding_time_per_event_ms": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "timed_ambiguity_particle_efficiency": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "timed_seeding_particle_efficiency": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "implementation_commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fullCommit"}]},
        "links": {"$ref": "#/$defs/links"},
        "record": {"type": "string", "minLength": 1}
      }
    },
    "combinationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "mechanism_key", "implementation_commit", "directly_inspected"],
      "dependentRequired": {
        "historical_record": ["files_changed"],
        "files_changed": ["historical_record"]
      },
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "mechanism_key": {"$ref": "#/$defs/label"},
        "implementation_commit": {"$ref": "#/$defs/fullCommit"},
        "directly_inspected": {"const": true},
        "historical_record": {
          "type": "string",
          "pattern": "^records/(Development|Evaluation)/[^/]+/summary\\.json$"
        },
        "files_changed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^optimization-files/[^#,]+#L[1-9][0-9]*-L[1-9][0-9]*(,L[1-9][0-9]*-L[1-9][0-9]*)*$"
          }
        }
      }
    },
    "combinationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "compatibility_rationale", "interaction_hypothesis"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/combinationSource"}
        },
        "compatibility_rationale": {"type": "string", "minLength": 1, "maxLength": 500},
        "interaction_hypothesis": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "proposalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "reference", "relevance", "directly_inspected"],
      "properties": {
        "source_type": {"enum": ["Genesis", "prior record/commit", "inspected source code", "external primary source"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "relevance": {"type": "string", "minLength": 1, "maxLength": 500},
        "directly_inspected": {"type": "boolean"},
        "inspected_scope": {"type": "string", "minLength": 1, "maxLength": 700},
        "acts_mapping": {"type": "string", "minLength": 1, "maxLength": 700}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"enum": ["inspected source code", "external primary source"]}}},
          "then": {
            "required": ["inspected_scope", "acts_mapping"],
            "properties": {
              "reference": {"type": "string", "pattern": "^https://"},
              "directly_inspected": {"const": true}
            }
          }
        }
      ]
    },
    "candidateProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate", "implementation_commit", "hypothesis", "falsifier", "predicted_directions", "expected_hot_path", "changed_symbols", "intended_files", "novelty_reason", "source_references", "combination_provenance"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "implementation_commit": {"$ref": "#/$defs/fullCommit"},
        "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1000},
        "falsifier": {"type": "string", "minLength": 1, "maxLength": 1000},
        "predicted_directions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timed_seeding_time_per_event_ms", "timed_seeding_particle_efficiency"],
          "properties": {
            "timed_seeding_time_per_event_ms": {"enum": ["decrease", "unchanged", "increase"]},
            "timed_seeding_particle_efficiency": {"enum": ["decrease", "unchanged", "increase"]}
          }
        },
        "expected_hot_path": {"type": "string", "minLength": 1, "maxLength": 700},
        "changed_symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "intended_files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^optimization-files/[^#]+$", "maxLength": 300}},
        "novelty_reason": {"type": "string", "minLength": 1, "maxLength": 700},
        "source_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proposalSource"}},
        "combination_provenance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/combinationProvenance"}]}
      }
    },
    "candidateLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "mechanism_key", "implementation_commit"],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "mechanism_key": {"$ref": "#/$defs/label"},
        "implementation_commit": {"$ref": "#/$defs/fullCommit"}
      }
    },
    "candidateAttempt": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "proposal": ["proposal_hash", "prediction_assessment", "prediction_assessment_rationale", "derives_from"],
        "proposal_hash": ["proposal"]
      },
      "oneOf": [
        {"required": ["timed_ambiguity_particle_efficiency"]},
        {"required": ["timed_seeding_particle_efficiency"]}
      ],
      "required": [
        "candidate",
        "mechanism_key",
        "mechanism_family",
        "classification",
        "state",
        "run_result",
        "outcome",
        "started_at",
        "finished_at",
        "duration_seconds",
        "timed_seeding_time_per_event_ms",
        "implementation_commit",
        "changed_symbols",
        "files_changed",
        "hot_path_rationale",
        "novelty_rationale",
        "lesson",
        "combination_provenance",
        "links",
        "record"
      ],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "mechanism_key": {"$ref": "#/$defs/label"},
        "mechanism_family": {"$ref": "#/$defs/label"},
        "classification": {"enum": ["major", "minor", "combination"]},
        "state": {"enum": ["completed", "failed"]},
        "run_result": {"type": "string", "minLength": 1, "maxLength": 500},
        "outcome": {"enum": ["keep", "discard", "crash"]},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "duration_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "timed_seeding_time_per_event_ms": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "timed_ambiguity_particle_efficiency": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "timed_seeding_particle_efficiency": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "implementation_commit": {"$ref": "#/$defs/fullCommit"},
        "changed_symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "files_changed": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileLineRange"}},
        "hot_path_rationale": {"type": "string", "minLength": 1, "maxLength": 500},
        "novelty_rationale": {"type": "string", "minLength": 1, "maxLength": 500},
        "lesson": {"type": "string", "minLength": 1, "maxLength": 500},
        "prediction_assessment": {"enum": ["held", "not held", "mixed", "inconclusive"]},
        "prediction_assessment_rationale": {"type": "string", "minLength": 1, "maxLength": 700},
        "proposal": {"$ref": "#/$defs/candidateProposal"},
        "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "derives_from": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidateLineage"}]},
        "combination_provenance": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/combinationProvenance"}]
        },
        "links": {"$ref": "#/$defs/links"},
        "record": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "combination"}}},
          "then": {
            "properties": {
              "combination_provenance": {"$ref": "#/$defs/combinationProvenance"}
            }
          },
          "else": {"properties": {"combination_provenance": {"type": "null"}}}
        }
      ]
    }
  }
}
